# Copy this file to .env and adjust as needed, then run: docker compose up -d --build

DB_NAME=mowliss
DB_ROOT_PASSWORD=root
DB_PORT=3306
WEB_PORT=80
APP_BASE_URL=http://localhost

# Twilio credentials for sending password-reset codes by SMS to PNG mobile numbers.
# Sign up at https://www.twilio.com/, buy/verify a sending number, then fill these in.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Brevo (https://www.brevo.com/) credentials for sending password-reset codes by email.
# Sign up, verify a sender email under Senders, Domains & Dedicated IPs, then create an
# API key under SMTP & API > API Keys.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
